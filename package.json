{
  "name": "notion-build-bar-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Notion Build Bar — cross-workspace booking sync hub (source of truth + sync engine + admin UI)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:notion": "tsx --env-file=.env.local scripts/create-notion-databases.ts",
    "rebuild:notion": "tsx --env-file=.env.local scripts/rebuild-notion-schema.ts",
    "register:event": "tsx --env-file=.env.local scripts/register-event.ts",
    "setup:expert-feedback": "tsx --env-file=.env.local scripts/configure-expert-feedback-db.ts",
    "setup:filtered": "tsx --env-file=.env.local scripts/add-filtered-property.ts",
    "send:feedback": "tsx --env-file=.env.local scripts/send-feedback.ts",
    "send:prep": "tsx --env-file=.env.local scripts/send-prep.ts",
    "send:cowork": "tsx --env-file=.env.local scripts/send-cowork-notice.ts",
    "decline:pending": "tsx --env-file=.env.local scripts/decline-pending.ts",
    "sync:luma-stats": "tsx --env-file=.env.local scripts/sync-luma-stats.ts",
    "backup": "tsx --env-file=.env.local scripts/backup-db.ts",
    "backfill:slack-ids": "tsx --env-file=.env.local scripts/backfill-slack-channel-ids.ts",
    "gen:types": "supabase gen types typescript --project-id jldgxdaemtdqcfrdzeby --schema public > lib/supabase/types.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.3",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/blob": "^2.6.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
