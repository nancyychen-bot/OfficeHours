# ============================================================================
# Office Hours Hub — environment
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================================

# --- Supabase (source of truth) ---
# Project: "Office Hours" (ref jldgxdaemtdqcfrdzeby), org nchen-notion's Org
NEXT_PUBLIC_SUPABASE_URL=https://jldgxdaemtdqcfrdzeby.supabase.co
# Publishable/anon key — safe for client use (get from Supabase dashboard > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Bypasses RLS. The hub uses this. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Luma (RSVP + check-in; system of record) ---
# Requires Luma Plus for API/webhook access (PRD §13).
LUMA_API_KEY=
# Shared secret used to verify inbound Luma webhooks (exact mechanism TBD by research).
LUMA_WEBHOOK_SECRET=

# --- Notion: Notion Dev workspace (internal) ---
# Internal integration token, scoped to the Notion Dev workspace only.
NOTION_DEV_TOKEN=
# Bookings database + data-source ids (printed by the create-databases script).
# Row reads/writes target the DATA SOURCE id (Notion API v2025-09-03+).
NOTION_DEV_BOOKINGS_DB_ID=
NOTION_DEV_BOOKINGS_DATA_SOURCE_ID=
# Shared secret for the Notion Dev database-automation "Send webhook" action.
NOTION_DEV_WEBHOOK_SECRET=

# --- Notion: Ambassador workspace (external) ---
# Internal integration token, scoped to the Ambassador workspace only.
NOTION_AMBASSADOR_TOKEN=
NOTION_AMBASSADOR_BOOKINGS_DB_ID=
NOTION_AMBASSADOR_BOOKINGS_DATA_SOURCE_ID=
NOTION_AMBASSADOR_WEBHOOK_SECRET=

# --- App ---
# Base URL of this hub (used when registering webhook endpoints).
APP_BASE_URL=http://localhost:3000
# Shared secret guarding the no-show cron endpoint (also set in Vercel).
CRON_SECRET=

# Note: check-in / cancellation emails are sent from Notion (Custom Agent /
# Gmail action) off Status changes, not from the hub — no email env needed here.
