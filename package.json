{
  "name": "office-hours-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Notion Office Hours — cross-workspace booking sync hub (source of truth + sync engine + admin UI)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:notion": "tsx --env-file=.env.local scripts/create-notion-databases.ts",
    "register:event": "tsx --env-file=.env.local scripts/register-event.ts",
    "gen:types": "supabase gen types typescript --project-id jldgxdaemtdqcfrdzeby --schema public > lib/supabase/types.ts"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.3",
    "@supabase/supabase-js": "^2.48.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
